#!/bin/sh
${CVI_SHOPTS}

# time_records at 0x0C00F01C lives in TPU_SYS region clocked by clk_tpu.
# Reading it directly via devmem would hang the bus if clk_tpu was gated by
# clk_disable_unused. Use /proc/time_records instead — the kernel interface
# handles clk_tpu prepare_enable/disable_unprepare around the ioremap read,
# so it is safe regardless of clk_tpu runtime state and does not depend on
# CONFIG_DEBUG_FS.

OUTPUT=/tmp/boottime

if [ -r /proc/time_records ]; then
	cat /proc/time_records > "$OUTPUT"
	{
		uname -a
		# extract ms values from /proc/time_records for derived metrics.
		# /proc/time_records format (per line):
		#   "  fsbl_start                 =   1018 ms"
		# Use cut to split on '=' for the field name, and on ' ' before 'ms' for the value.
		fsbl_start=$(sed -n 's/^  fsbl_start *= *\([0-9]*\) ms.*/\1/p' "$OUTPUT")
		ddr_init_start=$(sed -n 's/^  ddr_init_start *= *\([0-9]*\) ms.*/\1/p' "$OUTPUT")
		ddr_init_end=$(sed -n 's/^  ddr_init_end *= *\([0-9]*\) ms.*/\1/p' "$OUTPUT")
		release_blcp_2nd=$(sed -n 's/^  release_blcp_2nd *= *\([0-9]*\) ms.*/\1/p' "$OUTPUT")
		echo "ROM elapsed time: ${fsbl_start} milliseconds"
		echo "DDR init elapsed time: $((ddr_init_end - ddr_init_start)) milliseconds"
		echo "C906L FreeRTOS start at: ${release_blcp_2nd} milliseconds"
		echo "Kernel uptime: $(awk '{print $1}' /proc/uptime) seconds"
		echo "Total boottime: ?"
	} >> "$OUTPUT"
else
	echo "/proc/time_records not available (kernel built without cost_time/early_time_log?)" > "$OUTPUT"
fi
